+    expect(ERA_ORDER).toEqual([
+      "stone", "medieval", "renaissance", "industrial", "modern", "future",
+    ]);
+    expect(ERA_ORDER).toHaveLength(6);
+  });
+
+  it("default config matches the spec", () => {
