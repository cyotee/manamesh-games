{
  "name": "manamesh-games",
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "packages/*",
    "!packages/manamesh",
    "packages/manamesh/packages/*"
  ],
  "scripts": {
    "build": "yarn workspace @cyotee/manamesh build",
    "dev:frontend": "yarn workspace @cyotee/manamesh dev",
    "test:frontend": "yarn workspace @cyotee/manamesh test",
    "build:timestreams-vercel": "node packages/timestreams/scripts/build-vercel.mjs",
    "deploy:timestreams": "node packages/timestreams/scripts/build-vercel.mjs && cd deploy/timestreams && vercel deploy --prod --yes --name timestreams"
  },
  "dependencies": {
    "@cyotee/boardgame.io": "workspace:*",
    "@cyotee/boardgameio-p2p": "workspace:*",
    "boardgame.io": "portal:./packages/boardgame.io"
  }
}
