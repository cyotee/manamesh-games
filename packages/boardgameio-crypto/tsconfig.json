{
  "compilerOptions": {
    // Mirror @manamesh/frontend's compiler standard (the code was authored
    // against it): strict, but not noUncheckedIndexedAccess, ES2020 lib.
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*"]
}
